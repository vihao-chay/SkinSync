{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd FE_skinsync && npm install",
  "buildCommand": "cd FE_skinsync && npm run build",
  "outputDirectory": "FE_skinsync/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://skinsync.somee.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
